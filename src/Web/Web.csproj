<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Ortak\Ortak.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.FastTree" Version="6.0.0" />
    <PackageReference Include="Microsoft.ML.ImageAnalytics" Version="6.0.0" />
    <PackageReference Include="Microsoft.ML.Vision" Version="6.0.0" />
    <PackageReference Include="SciSharp.TensorFlow.Redist" Version="2.16.0" />
  </ItemGroup>

  <!-- Eğitilmiş modeller paketin (publish) içine kopyalanır -->
  <ItemGroup>
    <None Include="..\..\modeller\*.zip;..\..\modeller\*.json" LinkBase="modeller" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Flash bellek paketi: çift tıklayıp açmak için -->
  <ItemGroup>
    <None Include="BASLAT.bat" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- TensorFlow'un ihtiyaç duyduğu Visual C++ çalışma zamanı, okul bilgisayarında kurulu olmayabilir diye pakete eklenir -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <None Include="$(SystemRoot)\System32\msvcp140.dll;$(SystemRoot)\System32\vcruntime140.dll;$(SystemRoot)\System32\vcruntime140_1.dll" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
